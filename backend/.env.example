# Copia este archivo como .env y completa los valores
# Solo para desarrollo local — NO subir .env al repo

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=la_dolorosa

# Gemini OCR
GEMINI_API_KEY=AIza...

# CORS (URLs del frontend separadas por coma)
CORS_ORIGINS=http://localhost:3000,https://dolorosa.misdeseos.cl

# URL del frontend (para redirects de OAuth)
FRONTEND_URL=https://dolorosa.misdeseos.cl

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api-dolorosa.misdeseos.cl/api/auth/google/callback

# Emergent Object Storage (opcional, para screenshots de pagos)
EMERGENT_KEY=
